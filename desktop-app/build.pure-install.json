{
  "appId": "com.jacecanvas.desktop",
  "productName": "JaceCanvas",
  "directories": { "output": "release-pure-install" },
  "compression": "store",
  "files": [
    "main.js",
    "preload.js",
    "server/**/*",
    "dist/**/*",
    "assets/**/*",
    "config/**/*",
    "package.json"
  ],
  "extraResources": [
    { "from": "server", "to": "server", "filter": ["**/*"] },
    { "from": "server/data", "to": "server/data" },
    { "from": "assets/ffmpeg", "to": "ffmpeg", "filter": ["**/*"] }
  ],
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "icon": "assets/icon1.ico",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "JaceCanvas",
    "installerIcon": "assets/icon1.ico",
    "uninstallerIcon": "assets/icon1.ico"
  },
  "electronDownload": { "mirror": "https://npmmirror.com/mirrors/electron/" }
}
