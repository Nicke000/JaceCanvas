{
    "name":  "ai-canvas-desktop",
    "version":  "3.11.6",
    "private":  true,
    "description":  "JaceCanvas - AI canvas application",
    "main":  "main.js",
    "author":  "AI Canvas Team",
    "license":  "MIT",
    "scripts":  {
                    "dev":  "vite",
                    "build:web":  "vite build",
                    "start":  "electron .",
                    "build":  "electron-builder",
                    "pack":  "electron-builder --dir"
                },
    "dependencies":  {
                         "@ant-design/icons":  "5.6.1",
                         "@react-three/drei":  "^10.7.7",
                         "@react-three/fiber":  "^9.6.1",
                         "@xyflow/react":  "^12.6.0",
                         "antd":  "5.24.0",
                         "camera-controls":  "^2.10.1",
                         "cors":  "^2.8.5",
                         "dexie":  "^4.0.11",
                         "dexie-react-hooks":  "^1.1.7",
                         "express":  "^4.21.0",
                         "lucide-react":  "^0.469.0",
                         "react":  "19.0.0",
                         "react-dom":  "19.0.0",
                         "sql.js":  "^1.12.0",
                         "three":  "0.185.1",
                         "zustand":  "^5.0.3"
                     },
    "devDependencies":  {
                            "@types/react":  "^19.0.0",
                            "@types/react-dom":  "^19.0.0",
                            "@types/three":  "^0.185.1",
                            "@vitejs/plugin-react":  "^4.4.0",
                            "electron":  "^35.7.5",
                            "electron-builder":  "^25.1.0",
                            "typescript":  "~5.7.0",
                            "vite":  "^6.2.0"
                        },
    "build":  {
                  "appId":  "com.jacecanvas.desktop",
                  "productName":  "JaceCanvas",
                  "directories":  {
                                      "output":  "release-v3.11.6"
                                  },
                  "files":  [
                                "main.js",
                                "preload.js",
                                "server/**/*",
                                "dist/**/*",
                                "assets/**/*",
                                "config/**/*",
                                "package.json"
                            ],
                   "extraResources":  [
                                         {
                                             "from":  "server",
                                             "to":  "server",
                                             "filter":  ["**/*"]
                                         },
                                         {
                                             "from":  "server/data",
                                             "to":  "server/data"
                                         },
                                         {
                                             "from":  "assets/ffmpeg",
                                             "to":  "ffmpeg",
                                             "filter":  ["**/*"]
                                         },
                                         {
                                             "from":  "assets/video2x",
                                             "to":  "video2x",
                                             "filter":  ["**/*"]
                                         }
                                     ],
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                               "icon":  "assets/icon.ico",
                              "signAndEditExecutable":  false
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "perMachine":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "JaceCanvas",
                               "installerIcon":  "assets/icon.ico",
                               "uninstallerIcon":  "assets/icon.ico"
                           }
              }
}
